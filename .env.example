# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Server ───────────────────────────────────────────────────────────────
PORT=8090

# ── Agora (shared by the ConvoAI-based providers: Anam + LemonSlice) ─────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Basic auth for the ConvoAI REST API: "Basic <base64(customerId:customerSecret)>"
AGORA_CONVOAI_AUTH=
AGORA_CONVOAI_ENDPOINT=https://api.agora.io/api/conversational-ai-agent/v2/projects

# ── Shared agent brain (an avatar still needs LLM + TTS + ASR to run) ────
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
TTS_VENDOR=
TTS_API_KEY=
TTS_VOICE_ID=
TTS_BASE_URL=
ASR_VENDOR=ares
ASR_LANGUAGE=en-US
AGENT_GREETING=Hello!

# Shared chroma-key green — Anam renders on it and we tell LemonSlice to use it
# too, so ONE key colour keys out both. Hex without '#', e.g. 6B9E82.
AVATAR_KEY_COLOR=6B9E82

# ── Provider 1 — Anam (ConvoAI avatar vendor "anam", renders on green) ──
ANAM_API_KEY=
ANAM_AVATAR_ID=

# ── Provider 2 — LemonSlice (ConvoAI avatar vendor "generic") ──────────
LEMONSLICE_API_KEY=
LEMONSLICE_API_BASE_URL=
# A PUBLIC image URL — LemonSlice builds the avatar from this photo.
LEMONSLICE_AVATAR_ID=

# ── Provider 3 — Trulience (self-contained iframe embed) ───────────────
TRULIENCE_AVATAR_ID=
# Agora agent endpoint (lambda URL) -> becomes the avatar's voice via agora_endpoint.
# Leave blank to have Trulience idle silently.
TRULIENCE_AGENT_ENDPOINT=

# ── Background video ───────────────────────────────────────────────────
YT_VIDEO_ID=kaJI9p_dSfs

# Silence reminder — keeps the avatar talking with no mic input
SILENCE_TIMEOUT_MS=8000
SILENCE_PROMPT=The viewer is quiet. Say one short, upbeat sentence to keep the demo lively.

# Hard cap on avatar session length (limits provider API spend)
MAX_SESSION_MS=120000
IDLE_TIMEOUT=30
